# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
META_WA_ALERT_TEMPLATE=

# Google Places (avaliações do Google Meu Negócio)
GOOGLE_PLACES_API_KEY=

# Mercado Livre (app do Radar — não o token da loja)
MERCADOLIVRE_ACCESS_TOKEN=

# Cron / worker de coleta
CRON_SECRET=

# IA — Gemini (preferencial) ou OpenAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App (em produção use https://radar.bmgtechai.com.br)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Mercado Pago (Pix + cartão / preapproval)
# Token de PRODUÇÃO (APP_USR-...), não o de teste.
# Chave pública para tokenizar cartão no browser (CreditCardForm).
# No painel do MP, cadastre o webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Liberar dashboard sem Pix (dev/teste). Em produção deixe vazio ou false.
ALLOW_SKIP_PAYMENT=true

# Asaas (legado, não usado no checkout atual)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
META_WA_ALERT_TEMPLATE=

# Google Places (avaliações do Google Meu Negócio)
GOOGLE_PLACES_API_KEY=

# Mercado Livre (app do Radar — OAuth da loja do cliente)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Token legado do app (opcional; preferir OAuth por canal)
MERCADOLIVRE_ACCESS_TOKEN=

# iFood Merchant API (OAuth)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CODE_VERIFIER=

# Cron / worker de coleta (endpoint pronto; schedule Netlify desabilitado até prod)
CRON_SECRET=

# IA — Gemini (preferencial) ou OpenAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App (em produção use https://radar.bmgtechai.com.br)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Mercado Pago (cartão / assinatura com trial 7 dias)
# Public Key no frontend (tokenização do cartão). Access Token só no backend.
# Ex.: NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-...
# Webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Liberar dashboard sem pagamento — REMOVIDO em produção.
# Não use ALLOW_SKIP_PAYMENT.

# Asaas (legado, não usado no checkout atual)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
